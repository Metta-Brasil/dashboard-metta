# ── Google Sheets (Service Account, leitura — servidor) ─────────────
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# ── Upstash Redis (cache aplicacional, REST) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Auth.js v5 ──────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Origem canônica do app (ex.: https://painel.mettabrasil.com.br).
# Definida, o Auth.js para de montar callback/sessão a partir do header
# Host — um preview *.vercel.app ou um Host forjado deixa de conseguir
# rodar o login como se fosse produção. Vazia: comportamento atual
# (confia no Host, que é o que o `trustHost: true` exige).
AUTH_URL=
# Allowlist opcional de e-mails, separados por vírgula. Restringe o
# acesso a nomes específicos DENTRO do domínio @mettabrasil.com.br.
# Vazia: comportamento atual — qualquer e-mail do domínio entra.
ALLOWED_EMAILS=

# ── Brevo (e-mail de verificação no cadastro) ───────────────────────
BREVO_API_KEY=

# ── Refresh de cache ────────────────────────────────────────────────
# POST /api/revalidate (usado pelo cron do GitHub Actions)
REVALIDATE_SECRET=
# GET /api/cron (Vercel Cron; injetado em prod, defina local pra testar)
CRON_SECRET=
